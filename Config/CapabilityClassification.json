{
  "description": "Classification of APPX/MSIX manifest capabilities, used by Test-AppxBackupCompatibility -CheckCapabilities to explain what a package will need at install time.",
  "documentation": "https://learn.microsoft.com/en-us/windows/uwp/packaging/app-capability-declarations",
  "restricted": {
    "description": "Restricted capabilities are gated by Microsoft. A Store submission needs explicit approval, and a sideloaded package may install but have the capability denied at runtime. These are the entries most likely to make a restored backup behave differently from the original.",
    "impact": "Warning",
    "names": [
      "runFullTrust",
      "allowElevation",
      "broadFileSystemAccess",
      "documentsLibrary",
      "appCaptureSettings",
      "cellularDeviceControl",
      "cellularDeviceIdentity",
      "cellularMessaging",
      "deviceUnlock",
      "enterpriseDeviceLockdown",
      "enterpriseDataPolicy",
      "extendedBackgroundTaskTime",
      "extendedExecutionCritical",
      "extendedExecutionUnconstrained",
      "gameBarServices",
      "inputInjectionBrokered",
      "inputObservation",
      "inputSuppression",
      "interopServices",
      "localSystemServices",
      "locationSystem",
      "modifiableApp",
      "networkConnectionManagerProvisioning",
      "networkDataPlanProvisioning",
      "oemDeployment",
      "oemPublicDirectory",
      "packageManagement",
      "packagePolicySystem",
      "packageQuery",
      "previewStore",
      "smBiosData",
      "startScreenManagement",
      "storeLicenseManagement",
      "targetedContent",
      "uiAutomation",
      "userPrincipalName",
      "userSigninSupport",
      "walletSystem"
    ]
  },
  "device": {
    "description": "Device capabilities give access to peripherals. Windows prompts the user for consent on first use, and a privacy setting can deny them, so a restored package may be functional but limited.",
    "impact": "Information",
    "names": [
      "location",
      "microphone",
      "webcam",
      "proximity",
      "bluetooth",
      "radios",
      "usb",
      "humaninterfacedevice",
      "pointOfService",
      "serialcommunication",
      "activity",
      "gazeInput",
      "lowLevelDevices",
      "optical",
      "wiFiControl"
    ]
  },
  "general": {
    "description": "General capabilities are granted at install time without a prompt and do not affect whether a backup can be restored.",
    "impact": "None",
    "names": [
      "internetClient",
      "internetClientServer",
      "privateNetworkClientServer",
      "allJoyn",
      "codeGeneration",
      "objects3D",
      "chat",
      "appointments",
      "contacts",
      "phoneCall",
      "backgroundMediaPlayback",
      "remoteSystem",
      "spatialPerception",
      "userAccountInformation",
      "userDataTasks",
      "userNotificationListener",
      "voipCall",
      "musicLibrary",
      "picturesLibrary",
      "videosLibrary",
      "removableStorage",
      "enterpriseAuthentication",
      "sharedUserCertificates"
    ]
  }
}
